<?xml version="1.0" encoding="utf-8"?>
<!-- Financial session data must never be included in Android's automatic
     cloud/device-transfer backups. Session tokens are stored in
     EncryptedSharedPreferences and are excluded here as defense in depth. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>

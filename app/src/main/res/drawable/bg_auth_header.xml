<?xml version="1.0" encoding="utf-8"?>
<!-- Navy gradient banner behind the logo on the auth screens. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="290"
        android:startColor="@color/brand_primary_light"
        android:centerColor="@color/brand_primary"
        android:endColor="@color/brand_primary_dark"
        android:type="linear" />
    <corners
        android:bottomLeftRadius="@dimen/radius_xl"
        android:bottomRightRadius="@dimen/radius_xl" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.LeakGuardAI" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>

        <!-- Teal drives focus rings, cursors, switches and progress, so every
             interactive state reads as one accent instead of three blues. -->
        <item name="colorAccent">@color/accent_teal</item>
        <item name="colorSecondary">@color/accent_teal</item>
        <item name="colorSecondaryVariant">@color/accent_teal_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorControlActivated">@color/accent_teal</item>
        <item name="colorControlHighlight">#1F2DBFA8</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/semantic_danger</item>

        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:navigationBarColor">@color/surface</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:fontFamily">sans-serif</item>

        <item name="materialButtonStyle">@style/Widget.LeakGuardAI.Button.Primary</item>
        <item name="bottomNavigationStyle">@style/Widget.LeakGuardAI.BottomNav</item>
        <item name="materialCardViewStyle">@style/Widget.LeakGuardAI.Card</item>
    </style>

    <!-- Auth screens sit under a navy banner, so the status bar must go navy
         with light icons. Previously they inherited the light status bar and
         the white icons/time disappeared into the gradient. -->
    <style name="Theme.LeakGuardAI.Auth" parent="Theme.LeakGuardAI">
        <item name="android:statusBarColor">@color/brand_primary_light</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:navigationBarColor">@color/background</item>
    </style>

    <style name="Theme.LeakGuardAI.Splash" parent="Theme.LeakGuardAI">
        <item name="android:windowBackground">@color/brand_primary</item>
        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:navigationBarColor">@color/brand_primary</item>
    </style>

    <style name="Theme.LeakGuardAI.NoActionBar.Surface" parent="Theme.LeakGuardAI" />
</resources>
